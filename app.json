{
  "expo": {
    "name": "Three Sentences",
    "slug": "three-sentences",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "threesentences",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e10"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.threesixtythree.threesentences",
      "backgroundColor": "#0e0e10",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0e10"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.threesixtythree.threesentences"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#0e0e10"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Three Sentences accesses your photos only when you choose a profile photo.",
          "cameraPermission": "Three Sentences uses your camera only when you choose to take a profile photo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
