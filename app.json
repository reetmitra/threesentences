{
  "expo": {
    "name": "Three Sentences",
    "slug": "three-sentences",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "threesentences",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06141B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.threesixtythree.threesentences",
      "backgroundColor": "#06141B",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06141B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.threesixtythree.threesentences"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#06141B"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "react-native-quick-crypto"
    ]
  }
}
